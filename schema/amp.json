{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-memory-protocol/amp/schema/amp.json",
  "title": "Agent Memory Protocol (AMP) v1.1 — Tool Schemas",
  "description": "JSON Schema definitions for all AMP tool inputs and outputs.",
  "definitions": {
    "Scope": {
      "type": "object",
      "description": "Multi-dimensional partition keys for scoping memory. v1.1 standard.",
      "properties": {
        "agent_id": {
          "type": "string",
          "description": "Logical identity of the agent."
        },
        "group_id": {
          "type": "string",
          "description": "Collaborative group or team identifier."
        },
        "workspace_id": {
          "type": "string",
          "description": "Shared workspace identifier."
        },
        "user_id": {
          "type": "string",
          "description": "The end-user interacting with the agent."
        },
        "session_id": {
          "type": "string",
          "description": "The specific conversation turn, flow, or run (alias: run_id)."
        },
        "app_id": {
          "type": "string",
          "description": "Specific product surface, app instance, or platform."
        },
        "org_id": {
          "type": "string",
          "description": "Tenant partition."
        }
      },
      "anyOf": [
        { "required": ["agent_id"] },
        { "required": ["group_id"] },
        { "required": ["workspace_id"] },
        { "required": ["user_id"] }
      ],
      "additionalProperties": false
    },
    "MemoryResult": {
      "type": "object",
      "description": "Canonical memory object returned in recall responses.",
      "required": ["id", "content", "score", "timestamp", "status", "scope"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Backend-assigned unique identifier."
        },
        "content": {
          "type": "string",
          "description": "Text content of the memory."
        },
        "score": {
          "type": "number",
          "description": "Relevance score for the query. 0.0–1.0 recommended; backend may use own scale."
        },
        "source": {
          "type": "string",
          "description": "Provenance label (e.g. user_stated, inferred, external)."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 creation time."
        },
        "status": {
          "type": "string",
          "enum": ["active", "pinned", "archived"],
          "description": "Current lifecycle status of the memory."
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "visibility": {
          "type": "string",
          "enum": ["private", "shared"],
          "deprecated": true,
          "description": "Deprecated in favor of multi-dimensional scoping in v1.1."
        },
        "metadata": {
          "type": "object",
          "description": "Backend-specific fields. Supports reserved AMP v1.1 metadata keys.",
          "properties": {
            "amp.ttl": {
              "type": "integer",
              "minimum": 0,
              "description": "Time-to-live in seconds from creation."
            },
            "amp.confidence": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0,
              "description": "System or model confidence score in the validity of the memory."
            },
            "amp.entities": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Extracted entities related to this memory."
            },
            "amp.relations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["subject", "predicate", "object"],
                "properties": {
                  "subject": { "type": "string" },
                  "predicate": { "type": "string" },
                  "object": { "type": "string" }
                }
              },
              "description": "Subject-Predicate-Object triplets for graph-based stores."
            },
            "amp.categories": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Broad classification categories for organizing memories."
            },
            "amp.summary": {
              "type": "string",
              "description": "A higher-order summarized representation of this memory."
            },
            "amp.provenance.message_id": {
              "type": "string",
              "description": "Unique identifier of the message that generated this memory."
            },
            "amp.provenance.run_id": {
              "type": "string",
              "description": "Unique session run identifier associated with memory generation."
            },
            "amp.lineage.parent_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Identifiers of parent memories merged/summarized during consolidation."
            }
          },
          "additionalProperties": true
        }
      }
    },
    "RecallFilters": {
      "type": "object",
      "description": "Optional filters for amp.recall.",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["active", "pinned", "archived"],
          "description": "Filter by memory status. If absent, backends SHOULD return active and pinned memories."
        },
        "visibility": {
          "type": "string",
          "enum": ["private", "shared"],
          "deprecated": true,
          "description": "Deprecated. Filter by visibility."
        },
        "source": {
          "type": "string",
          "description": "Filter by provenance label."
        },
        "timestamp_after": {
          "type": "string",
          "format": "date-time",
          "description": "Return only memories created after this time."
        },
        "timestamp_before": {
          "type": "string",
          "format": "date-time",
          "description": "Return only memories created before this time."
        },
        "metadata_filters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MetadataFilter"
          },
          "description": "Structured conditional queries targeting specific metadata attributes. Standard v1.2 extension."
        }
      },
      "additionalProperties": false
    },
    "MetadataFilter": {
      "type": "object",
      "description": "Structured metadata key-value constraint.",
      "required": ["key", "operator", "value"],
      "properties": {
        "key": {
          "type": "string",
          "description": "The exact metadata attribute key path to query."
        },
        "operator": {
          "type": "string",
          "enum": ["eq", "ne", "gte", "lte", "contains", "in"],
          "description": "Comparison operator."
        },
        "value": {
          "type": ["string", "number", "boolean", "array"],
          "description": "The target value(s) to match."
        }
      },
      "additionalProperties": false
    },
    "AmpErrorData": {
      "type": "object",
      "description": "AMP error payload placed in the JSON-RPC error data field.",
      "required": ["amp_error_code", "message"],
      "properties": {
        "amp_error_code": {
          "type": "string",
          "enum": ["invalid_request", "unauthorized", "forbidden", "not_found", "not_supported", "backend_error"],
          "description": "AMP-specific error code."
        },
        "message": {
          "type": "string",
          "description": "Human-readable error description."
        }
      }
    }
  },
  "tools": {
    "amp.encode": {
      "description": "Store a new memory for an agent.",
      "input": {
        "type": "object",
        "required": ["content"],
        "anyOf": [
          { "required": ["scope"] },
          { "required": ["agent_id"] }
        ],
        "properties": {
          "scope": {
            "$ref": "#/definitions/Scope"
          },
          "agent_id": {
            "type": "string",
            "description": "Legacy namespace identifier for the calling agent (mapped to scope.agent_id)."
          },
          "private": {
            "type": "boolean",
            "default": false,
            "deprecated": true,
            "description": "Deprecated in favor of multi-dimensional scoping."
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "Text content to store as a memory."
          },
          "source": {
            "type": "string",
            "description": "Provenance label (e.g. user_stated, inferred, external)."
          },
          "force": {
            "type": "boolean",
            "default": false,
            "description": "If true, bypass salience threshold and store unconditionally."
          },
          "metadata": {
            "type": "object",
            "description": "Hints to the backend (e.g. salience, modality). Supports reserved AMP keys.",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "id": {
            "type": "string",
            "description": "New memory identifier. Present when status is 'stored', 'duplicate', or 'queued'."
          },
          "status": {
            "type": "string",
            "enum": ["stored", "duplicate", "below_threshold", "queued"],
            "description": "Outcome of the encode operation."
          },
          "visibility": {
            "type": "string",
            "enum": ["private", "shared"],
            "deprecated": true,
            "description": "Deprecated. Echoes back memory visibility."
          },
          "event_id": {
            "type": "string",
            "description": "Optional async processing/transaction reference for status='queued'."
          }
        }
      }
    },
    "amp.recall": {
      "description": "Retrieve memories relevant to a query.",
      "input": {
        "type": "object",
        "required": ["query"],
        "anyOf": [
          { "required": ["scope"] },
          { "required": ["agent_id"] }
        ],
        "properties": {
          "scope": {
            "$ref": "#/definitions/Scope"
          },
          "agent_id": {
            "type": "string",
            "description": "Legacy namespace identifier for the calling agent (mapped to scope.agent_id)."
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Natural language or keyword query."
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "default": 10,
            "description": "Maximum number of results to return."
          },
          "filters": {
            "$ref": "#/definitions/RecallFilters"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": ["results"],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/MemoryResult"
            },
            "description": "Memories ordered by descending relevance score."
          }
        }
      }
    },
    "amp.forget": {
      "description": "Permanently delete a memory.",
      "input": {
        "type": "object",
        "required": ["id"],
        "anyOf": [
          { "required": ["scope"] },
          { "required": ["agent_id"] }
        ],
        "properties": {
          "scope": {
            "$ref": "#/definitions/Scope"
          },
          "agent_id": {
            "type": "string",
            "description": "Legacy namespace identifier for the calling agent (mapped to scope.agent_id)."
          },
          "id": {
            "type": "string",
            "description": "ID of the memory to delete."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["forgotten", "not_found"],
            "description": "Outcome of the forget operation."
          }
        }
      }
    },
    "amp.consolidate": {
      "description": "Trigger backend consolidation. Full conformance only.",
      "input": {
        "type": "object",
        "anyOf": [
          { "required": ["scope"] },
          { "required": ["agent_id"] }
        ],
        "properties": {
          "scope": {
            "$ref": "#/definitions/Scope"
          },
          "agent_id": {
            "type": "string",
            "description": "Legacy namespace identifier for the calling agent (mapped to scope.agent_id)."
          },
          "depth": {
            "type": "string",
            "enum": ["full", "light"],
            "default": "full",
            "description": "Consolidation depth. 'full' = complete pass; 'light' = minimal/incremental pass."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["queued", "ok", "not_supported"],
            "description": "Outcome of the consolidate operation."
          },
          "memories_processed": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of memories processed. Present when status is 'ok'."
          }
        }
      }
    },
    "amp.pin": {
      "description": "Mark a memory as permanent (never archived by consolidation). Full conformance only.",
      "input": {
        "type": "object",
        "required": ["id"],
        "anyOf": [
          { "required": ["scope"] },
          { "required": ["agent_id"] }
        ],
        "properties": {
          "scope": {
            "$ref": "#/definitions/Scope"
          },
          "agent_id": {
            "type": "string",
            "description": "Legacy namespace identifier for the calling agent (mapped to scope.agent_id)."
          },
          "id": {
            "type": "string",
            "description": "ID of the memory to pin."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["pinned", "not_found", "not_supported"],
            "description": "Outcome of the pin operation."
          }
        }
      }
    },
    "amp.stats": {
      "description": "Return backend statistics for an agent namespace.",
      "input": {
        "type": "object",
        "anyOf": [
          { "required": ["scope"] },
          { "required": ["agent_id"] }
        ],
        "properties": {
          "scope": {
            "$ref": "#/definitions/Scope"
          },
          "agent_id": {
            "type": "string",
            "description": "Legacy namespace identifier for the calling agent (mapped to scope.agent_id)."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": ["memory_count"],
        "properties": {
          "memory_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Total number of active and pinned memories."
          },
          "unconsolidated_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of memories not yet consolidated. Optional for Core backends."
          },
          "metadata": {
            "type": "object",
            "description": "Backend-specific statistics. Supports reserved AMP keys.",
            "additionalProperties": true
          }
        }
      }
    },
    "amp.update": {
      "description": "Mutate an existing memory's content or metadata. Core performance feature.",
      "input": {
        "type": "object",
        "required": ["id"],
        "anyOf": [
          { "required": ["scope"] },
          { "required": ["agent_id"] }
        ],
        "properties": {
          "scope": {
            "$ref": "#/definitions/Scope"
          },
          "agent_id": {
            "type": "string",
            "description": "Legacy namespace identifier for the calling agent (mapped to scope.agent_id)."
          },
          "id": {
            "type": "string",
            "description": "ID of the memory to update."
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "Updated text content of the memory (optional if updating metadata only)."
          },
          "metadata": {
            "type": "object",
            "description": "Updated metadata keys to merge or set. Supports reserved AMP keys.",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["updated", "not_found", "not_supported"],
            "description": "Outcome of the update operation."
          }
        }
      }
    },
    "amp.batch_encode": {
      "description": "Store multiple new memories for an agent in a single batch operation.",
      "input": {
        "type": "object",
        "required": ["memories"],
        "anyOf": [
          { "required": ["scope"] },
          { "required": ["agent_id"] }
        ],
        "properties": {
          "scope": {
            "$ref": "#/definitions/Scope"
          },
          "agent_id": {
            "type": "string",
            "description": "Legacy namespace identifier for the calling agent (mapped to scope.agent_id)."
          },
          "memories": {
            "type": "array",
            "minItems": 1,
            "description": "List of memory payloads to store.",
            "items": {
              "type": "object",
              "required": ["content"],
              "properties": {
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Text content to store."
                },
                "source": {
                  "type": "string",
                  "description": "Provenance label."
                },
                "force": {
                  "type": "boolean",
                  "default": false,
                  "description": "If true, bypass salience threshold and store unconditionally."
                },
                "metadata": {
                  "type": "object",
                  "description": "Metadata bag for this individual memory.",
                  "additionalProperties": true
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": ["results"],
        "properties": {
          "results": {
            "type": "array",
            "description": "Outcomes corresponding to each input memory in order.",
            "items": {
              "type": "object",
              "required": ["status"],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "New memory identifier if stored or queued."
                },
                "status": {
                  "type": "string",
                  "enum": ["stored", "duplicate", "below_threshold", "queued"],
                  "description": "Outcome of storing this memory."
                },
                "event_id": {
                  "type": "string",
                  "description": "Optional async event reference if status is 'queued'."
                }
              }
            }
          }
        }
      }
    }
  }
}
